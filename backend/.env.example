NODE_ENV=development
PORT=5000

MONGODB_URI=mongodb://127.0.0.1:27017/skillcert_ai

JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d
COOKIE_EXPIRES_DAYS=7

CLIENT_URL=http://localhost:3000
API_BASE_URL=http://localhost:5000
FRONTEND_URL=http://localhost:3000

GROQ_API_KEY=your_groq_api_key
GROQ_TEXT_MODEL=llama-3.3-70b-versatile
GROQ_TRANSCRIBE_MODEL=whisper-large-v3-turbo

MAX_VIDEO_SIZE_MB=500
MAX_TRANSCRIPT_CHARACTERS=120000

ADMIN_NAME=SkillCert Admin
ADMIN_EMAIL=admin@skillcert.ai
ADMIN_PASSWORD=replace_with_a_strong_admin_password


CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

CLOUDINARY_VIDEO_FOLDER=skillcert-ai/videos
CLOUDINARY_IMAGE_FOLDER=skillcert-ai/images
CLOUDINARY_CERTIFICATE_FOLDER=skillcert-ai/certificates
